# PatchPilot AI environment configuration
# Copy to .env and set values as needed. Never commit .env

# Application
APP_NAME=PatchPilot AI
ENV=development
LOG_LEVEL=INFO

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini
GEMINI_API_KEY=
MODEL_NAME=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=60

# Execution
# local (default, no Docker required) or docker
EXECUTION_MODE=local
LOCAL_TIMEOUT_SECONDS=300
DOCKER_TIMEOUT_SECONDS=600
PATCH_APPLY_TIMEOUT_SECONDS=30
DOCKER_INFO_TIMEOUT_SECONDS=10


# Limits
MAX_PATCH_SIZE_BYTES=1048576
MAX_BUG_REPORT_CHARS=10000
MAX_FILES_COUNT=100
MAX_FILE_SIZE_BYTES=1048576

